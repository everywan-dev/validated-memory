{
  "description": "On every session start: restores the validated-memory --harness-memory symlink, and refreshes whichever HTML views an adopter project has already activated.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/restore-memory-symlink.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/refresh-views.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
